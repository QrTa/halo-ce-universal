	<strings name="main_menu/settings_select/player_setup/player_profile_edit/gameplay/skulls/help_strings">
		<string text=""/>
		<string text="On: after a campaign level's difficulty, a screen\nturns the Master Chief Collection's skulls on."/>
		<string text="On: every skull can be picked, and none drop.\nOff: enemies drop the skulls you haven't found."/>
		<string text="On: a skull you pick up is unlocked at once.\nOff: finish the level to unlock it."/>
		<string text="On: dying loses the skulls you picked up and\nhave not unlocked yet. Off: you keep them."/>
		<string text="Forget every skull found, and ask again how\nthe skulls are had."/>
		<string text="Press A again to forget every skull found.\nThis cannot be undone."/>
		<string text="Skull progress reset. Every skull is to be\nfound again."/>
